# ============================================
# QHALI Backend — Variables de Entorno
# ============================================
# Copiar este archivo como .env y ajustar valores

# ── Aplicación ──
APP_NAME=QHALI API
APP_VERSION=0.1.0
DEBUG=True

# ── Base de Datos (PostgreSQL) ──
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qhali

# ── Autenticación (JWT) ──
SECRET_KEY=cambiar-esta-clave-en-produccion
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# ── Geolocalización ──
NEARBY_RADIUS_METERS=300.0
DUPLICATE_RADIUS_METERS=50.0

# ── Archivos ──
MAX_PHOTO_SIZE_MB=5
UPLOAD_DIR=uploads

# ── CORS ──
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

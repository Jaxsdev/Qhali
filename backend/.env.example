# ============================================
# QHALI Backend — Variables de Entorno
# Sprint 2: Autenticación básica e identidad anónima
# ============================================
# Copiar este archivo como .env y ajustar valores

# ── Aplicación ──
APP_NAME=QHALI API
APP_VERSION=0.2.0
DEBUG=True

# ── Base de Datos ──
# SQLite para desarrollo local (Sprint 2):
DATABASE_URL=sqlite:///./qhali.db
# PostgreSQL para producción (descomentar cuando se tenga el servidor):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qhali

# ── Autenticación (JWT) ──
# IMPORTANTE: cambiar SECRET_KEY en producción (mínimo 32 chars aleatorios)
SECRET_KEY=cambiar-esta-clave-en-produccion-minimo-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# ── Geolocalización ──
NEARBY_RADIUS_METERS=300.0
DUPLICATE_RADIUS_METERS=50.0

# ── Archivos / Fotos ──
MAX_PHOTO_SIZE_MB=5
UPLOAD_DIR=uploads

# ── CORS ──
# Agregar el origen del frontend (Next.js en desarrollo)
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
